# Copie este arquivo para .env e preencha as chaves. Nunca versione o arquivo .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos padrao equilibrados. Podem ser trocados sem alterar o codigo.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=2048

# openai ou claude. O outro provedor funciona como fallback e revisor.
DEADPOOL_PRIMARY_PROVIDER=openai
