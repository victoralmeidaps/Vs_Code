#!/usr/bin/env sh
# Corrige os .md staged, re-staga o corrigido e bloqueia o que nao e auto-fixavel.
tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp"' EXIT
git diff --cached --name-only --diff-filter=ACM -z -- '*.md' '*.markdown' > "$tmp"
[ -s "$tmp" ] || exit 0
status=0
xargs -0 -r npx markdownlint-cli2 --fix -- < "$tmp" || status=$?
xargs -0 -r git add -- < "$tmp"
exit $status
